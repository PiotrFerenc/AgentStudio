@page "/agents/{Id:guid}"
@attribute [Authorize]
@rendermode InteractiveServer
@inject AgentStudio.Web.Services.StudioApiClient Api
@using AgentStudio.Domain
@using AgentStudio.Contracts

<PageTitle>@(Agent?.Name ?? "Agent")</PageTitle>

@if (Agent is null)
{
    <p>Loading...</p>
}
else if (!_canEdit)
{
    <div class="panel">
        <h2>@Agent.Name</h2>
        <p>You don't have edit access to this agent — only its owner (@(Agent.OwnerUsername ?? "unknown")), a collaborator, or an Admin can open it.</p>
        <p><a href="/">Back to agents</a></p>
    </div>
}
else
{
    <div class="panel">
        <h2>@Agent.Name <span class="badge">@Agent.ModelProviderName / @Agent.ModelName</span></h2>
        @if (Agent.OwnerUsername is not null)
        {
            <p style="color:#868e96;font-size:.8rem;margin-top:-.3rem">Owned by @Agent.OwnerUsername</p>
        }
        <p>@Agent.Description</p>
        <p>
            Draft status: <strong>@DraftStatus</strong>
            <button class="primary" @onclick="SaveAsync">Save draft</button>
            <button class="secondary" @onclick="PublishAsync">Publish version</button>
            <button class="secondary" @onclick="RegenerateKeyAsync">Regenerate API key</button>
            @if (!string.IsNullOrEmpty(_publishMessage))
            {
                <span style="margin-left:1rem">@_publishMessage</span>
            }
        </p>
    </div>

    <div class="agent-tabs">
        <button class="agent-tab-btn @(_activeTab == "build" ? "active" : "")" @onclick='() => _activeTab = "build"'>Build</button>
        <button class="agent-tab-btn @(_activeTab == "overview" ? "active" : "")" @onclick='() => _activeTab = "overview"'>Overview</button>
        <button class="agent-tab-btn @(_activeTab == "form" ? "active" : "")" @onclick='() => _activeTab = "form"'>Form</button>
        <button class="agent-tab-btn @(_activeTab == "chat" ? "active" : "")" @onclick='() => _activeTab = "chat"'>Test Chat</button>
        <button class="agent-tab-btn @(_activeTab == "docs" ? "active" : "")" @onclick='() => _activeTab = "docs"'>Documents</button>
        <button class="agent-tab-btn @(_activeTab == "logs" ? "active" : "")" @onclick='() => _activeTab = "logs"'>Logs</button>
    </div>

    @if (_activeTab == "overview")
    {
    <div class="panel">
        <p title="Default provider/model for prompt and documentSearch nodes — a node can override this individually.">
            <label style="display:inline;margin:0">Model provider</label>
            <select style="display:inline-block;margin:0 .3rem" @bind="_providerName" @bind:after="OnProviderSelected">
                <option value="">-- select --</option>
                @foreach (var p in _allProviders ?? new())
                {
                    <option value="@p.Name">@p.Name (@p.BaseUrl)</option>
                }
            </select>
            <label style="display:inline;margin:0">Model</label>
            <input type="text" style="width:10em;display:inline-block;margin:0 .3rem" @bind="_modelName" @bind:event="oninput" placeholder="e.g. llama3.1" />
            <button class="secondary" style="padding:.15rem .6rem;font-size:.75rem" @onclick="SaveProviderAsync">Save provider</button>
            @if (_providerMessage is not null)
            {
                <span style="margin-left:.5rem;font-size:.8rem;color:@(_providerMessage == "Saved." ? "#2f9e44" : "#c92a2a")">@_providerMessage</span>
            }
        </p>
        <p>
            <label style="display:inline;margin:0" title="Safety cap on total node executions per run — also the loop-iteration guard.">Max steps</label>
            <input type="number" min="1" style="width:6em;display:inline-block;margin:0 0 0 .4rem" @bind="_maxSteps" @bind:event="oninput" />
        </p>
        <p style="margin-top:.5rem" title="Runs the latest published version automatically, using Input as {input} — independent of chat/form/webhook triggers.">
            <label style="display:inline;margin:0">Schedule</label>
            <input type="checkbox" style="margin:0 .3rem 0 .5rem;vertical-align:middle" @bind="_scheduleEnabled" />
            <label style="display:inline;margin:0">every</label>
            <input type="number" min="1" style="width:5em;display:inline-block;margin:0 .3rem" @bind="_scheduleIntervalMinutes" @bind:event="oninput" /> min
            <input type="text" placeholder="Input for each run" style="width:14em;display:inline-block;margin:0 .3rem" @bind="_scheduleInput" @bind:event="oninput" />
            <button class="secondary" style="padding:.15rem .6rem;font-size:.75rem" @onclick="SaveScheduleAsync">Save schedule</button>
            @if (Agent.LastScheduledRunAt is not null)
            {
                <span style="margin-left:.5rem;color:#868e96;font-size:.8rem">last run: @Agent.LastScheduledRunAt.Value.ToLocalTime().ToString("g")</span>
            }
            @if (_scheduleMessage is not null)
            {
                <span style="margin-left:.5rem;font-size:.8rem">@_scheduleMessage</span>
            }
        </p>
        <p style="margin-top:.5rem" title="Named config values for this agent, reachable in any template as {variables.env.NAME} — an alternative to hardcoding a value in the graph.">
            <label style="display:block;margin:0 0 .3rem">Environment variables (one per line: name=value)</label>
            <textarea @bind="_envVarsText" style="width:100%;max-width:28rem;min-height:4rem;font-family:var(--mono, monospace);font-size:.82rem" placeholder="API_URL=https://example.com"></textarea>
            <button class="secondary" style="display:block;margin-top:.35rem;padding:.15rem .6rem;font-size:.75rem" @onclick="SaveEnvironmentVariablesAsync">Save environment variables</button>
            @if (_envVarsMessage is not null)
            {
                <span style="margin-left:.5rem;font-size:.8rem">@_envVarsMessage</span>
            }
        </p>
        @if (_newApiKey is not null)
        {
            <p style="margin-top:.5rem">
                New API key (shown once — copy it now): <code>@_newApiKey</code>
                <button class="secondary" style="margin-left:.5rem;padding:.15rem .6rem;font-size:.75rem"
                        @onclick="CopyApiKey">copy</button>
            </p>
        }
        @if (_publishedVersions.Any())
        {
            <p style="margin-top:.5rem">
                Public chat links:
                @foreach (var v in _publishedVersions)
                {
                    <div style="margin:.25rem 0">
                        <code>/chat/@Agent.Id/@v.Version?key=YOUR_API_KEY</code>
                        <button class="secondary" style="margin:0 0 0 .5rem;padding:.15rem .6rem;font-size:.75rem"
                                @onclick="() => CopyLink(v.Version)">copy</button>
                        <button class="secondary" style="margin:0 0 0 .5rem;padding:.15rem .6rem;font-size:.75rem"
                                @onclick="() => UnpublishAsync(v.Version)">unpublish</button>
                        <button class="secondary" style="margin:0 0 0 .5rem;padding:.15rem .6rem;font-size:.75rem"
                                @onclick="() => RepublishAsync(v.Version)">republish</button>
                    </div>
                    @if (v.FormFields.Count > 0)
                    {
                        <div style="margin:.1rem 0 .25rem">
                            <code>/run/@Agent.Id/@v.Version?key=YOUR_API_KEY</code>
                            <button class="secondary" style="margin:0 0 0 .5rem;padding:.15rem .6rem;font-size:.75rem"
                                    @onclick="() => CopyFormLink(v.Version)">copy</button>
                        </div>
                    }
                    <div style="margin:.1rem 0 .25rem;color:#868e96;font-size:.8rem">
                        webhook: <code>POST /api/agents/@Agent.Id/versions/@v.Version/webhook</code> (header <code>X-Agent-Api-Key</code>, any JSON body — top-level keys become <code>{variables.x}</code>)
                    </div>
                }
            </p>
        }
        @if (_unpublishedVersions.Any())
        {
            <p style="margin-top:.5rem">
                Unpublished versions:
                @foreach (var v in _unpublishedVersions)
                {
                    <div style="margin:.25rem 0">
                        <code>v@v.Version</code>
                        <button class="secondary" style="margin:0 0 0 .5rem;padding:.15rem .6rem;font-size:.75rem"
                                @onclick="() => RepublishAsync(v.Version)">republish</button>
                    </div>
                }
            </p>
        }
        @if (_validation is not null && !_validation.IsValid)
        {
            <ul class="error-list">
                @foreach (var e in _validation.Errors)
                {
                    <li>@e</li>
                }
            </ul>
        }
        @if (_diffOptions.Count > 1)
        {
            <div style="margin-top:.75rem">
                <label style="display:inline;margin:0">Compare</label>
                <select style="display:inline-block;width:auto;margin:0 .4rem" @bind="_diffFrom" @bind:after="RunDiff">
                    @foreach (var o in _diffOptions)
                    {
                        <option value="@o">@o</option>
                    }
                </select>
                <label style="display:inline;margin:0">to</label>
                <select style="display:inline-block;width:auto;margin:0 .4rem" @bind="_diffTo" @bind:after="RunDiff">
                    @foreach (var o in _diffOptions)
                    {
                        <option value="@o">@o</option>
                    }
                </select>
                @if (_diffResult is not null)
                {
                    @if (_diffResult.IsEmpty)
                    {
                        <p style="color:#868e96;font-size:.85rem;margin-top:.5rem">No differences.</p>
                    }
                    else
                    {
                        <ul style="margin-top:.5rem;font-size:.85rem">
                            @foreach (var n in _diffResult.Nodes)
                            {
                                <li>
                                    <span style="color:@DiffColor(n.ChangeKind);font-weight:650">@n.ChangeKind</span>
                                    node <code>@n.NodeId</code> (@n.Type)
                                    @if (n.ChangedProps.Count > 0)
                                    {
                                        <text> — changed: @string.Join(", ", n.ChangedProps)</text>
                                    }
                                </li>
                            }
                            @foreach (var e in _diffResult.Edges)
                            {
                                <li>
                                    <span style="color:@DiffColor(e.ChangeKind);font-weight:650">@e.ChangeKind</span>
                                    edge <code>@e.SourceNodeId</code> → <code>@e.TargetNodeId</code>@(e.Branch is null ? "" : $" ({e.Branch})")
                                </li>
                            }
                        </ul>
                    }
                }
            </div>
        }
    </div>

    @if (_canManageSharing)
    {
        <div class="panel">
            <h2>Share</h2>
            <p style="color:#868e96;font-size:.85rem">Collaborators can edit this agent same as you, but only the owner or an Admin can change who else has access.</p>
            @if (Agent.Collaborators.Count > 0)
            {
                <ul>
                    @foreach (var c in Agent.Collaborators)
                    {
                        <li>@c.Username <button class="secondary" style="margin-left:.5rem;padding:.1rem .5rem;font-size:.72rem" @onclick="() => RemoveCollaboratorAsync(c.UserId)">Remove</button></li>
                    }
                </ul>
            }
            <input type="text" @bind="_newCollaboratorUsername" @bind:event="oninput" placeholder="Username" style="width:14em;display:inline-block" />
            <button class="secondary" style="padding:.15rem .6rem;font-size:.75rem" @onclick="AddCollaboratorAsync">Add collaborator</button>
            @if (_shareError is not null)
            {
                <p class="error-list">@_shareError</p>
            }
        </div>
    }
    }

    @if (_activeTab == "build")
    {
    <div class="panel">
        <h2>Workflow Graph</h2>
        <div style="display:flex;gap:1rem;flex-wrap:wrap">
            <div style="flex:2;min-width:480px">
                <GraphEditor Graph="_graph" GraphChanged="OnGraphChanged" @ref="_editor"
                             AvailableComponents="_availableComponents"
                             ComponentSaveRequested="OnComponentSaveRequested"
                             ComponentDeleteRequested="OnComponentDeleteRequested"
                             AgentId="Id" />
            </div>
            <div style="flex:1;min-width:280px">
                <NodePropertiesEditor SelectedNode="_selectedNode" NodeChanged="OnNodeChanged" AvailableAgents="_allAgents" AvailableProviders="_allProviders" AvailableConnections="_allConnections" AvailableIntegrators="_allIntegrators" AgentId="Id" Graph="_graph" />
            </div>
        </div>
    </div>
    }

    @if (_activeTab == "docs")
    {
    <div class="panel">
        <h2>Documents (RAG)</h2>
        <p style="color:#868e96;font-size:.85rem">Plain text only (.txt, .md, .csv, .json, .log). Needs an embedding model on this agent's provider — set one on the Providers page.</p>
        @if (_documents is null)
        {
            <p>Loading...</p>
        }
        else if (_documents.Count == 0)
        {
            <p>No documents yet.</p>
        }
        else
        {
            <table>
                <thead><tr><th>File</th><th>Uploaded</th><th></th></tr></thead>
                <tbody>
                    @foreach (var d in _documents)
                    {
                        <tr>
                            <td>@d.FileName</td>
                            <td>@d.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td><button class="secondary" @onclick="() => DeleteDocumentAsync(d.Id)">Delete</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        <InputFile OnChange="UploadDocumentAsync" />
        @if (_documentError is not null)
        {
            <p class="error-list">@_documentError</p>
        }
    </div>
    }

    @if (_activeTab == "form")
    {
    <div class="panel">
        <h2>Form (alternative to chat)</h2>
        <p style="color:#868e96;font-size:.85rem">Named fields become <code>{variables.name}</code> in the graph. Published together with the graph — publish a new version to expose changes at <code>/run/{agentId}/{version}</code>.</p>

        <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-bottom:.75rem">
            <div style="flex:1;min-width:160px">
                <label style="margin-top:0">Result mode</label>
                <select @bind="_formResultMode">
                    <option value="inline">inline</option>
                    <option value="redirect">redirect</option>
                    <option value="webhook">webhook</option>
                </select>
            </div>
            <div style="flex:2;min-width:260px">
                <label style="margin-top:0">Result target (URL — supports {result}/{conversationId}/{executionId})</label>
                <input type="text" @bind="_formResultTarget" @bind:event="oninput" placeholder="https://example.com/hook?r={result}" />
            </div>
            <div style="min-width:160px;display:flex;align-items:flex-end;padding-bottom:.5rem">
                <label style="margin:0;display:flex;align-items:center;gap:.4rem">
                    <input type="checkbox" style="width:auto;margin:0" @bind="_formResultMarkdown" />
                    Render inline result as Markdown
                </label>
            </div>
        </div>

        @if (_formFields.Count == 0)
        {
            <p>No fields yet.</p>
        }
        else
        {
            <table>
                <thead><tr><th>Name</th><th>Label</th><th>Type</th><th>Options (comma-separated)</th><th>Required</th><th>Order</th><th></th></tr></thead>
                <tbody>
                    @foreach (var f in _formFields)
                    {
                        <tr>
                            <td><input type="text" @bind="f.Name" @bind:event="oninput" /></td>
                            <td><input type="text" @bind="f.Label" @bind:event="oninput" /></td>
                            <td>
                                <select @bind="f.Type">
                                    <option value="text">text</option>
                                    <option value="number">number</option>
                                    <option value="textarea">textarea</option>
                                    <option value="select">select</option>
                                    <option value="checkbox">checkbox</option>
                                    <option value="date">date</option>
                                    <option value="email">email</option>
                                    <option value="url">url</option>
                                </select>
                            </td>
                            <td><input type="text" value="@string.Join(",", f.Options)" @onchange="e => SetOptions(f, e)" disabled="@(f.Type != FormFieldTypeSelect)" /></td>
                            <td><input type="checkbox" style="width:auto" @bind="f.Required" /></td>
                            <td style="white-space:nowrap">
                                <button class="secondary" style="margin:0 .25rem 0 0;padding:.15rem .5rem" title="Move up" @onclick="() => MoveFieldUp(f)" disabled="@(_formFields.IndexOf(f) == 0)">▲</button>
                                <button class="secondary" style="margin:0;padding:.15rem .5rem" title="Move down" @onclick="() => MoveFieldDown(f)" disabled="@(_formFields.IndexOf(f) == _formFields.Count - 1)">▼</button>
                            </td>
                            <td><button class="secondary" @onclick="() => _formFields.Remove(f)">Remove</button></td>
                        </tr>
                        <tr>
                            <td colspan="7" style="padding:0 .75rem .9rem">
                                <details>
                                    <summary style="cursor:pointer;font-size:.78rem;color:var(--ink-2);font-weight:600">Advanced</summary>
                                    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:0 1rem;margin-top:.25rem">
                                        <div>
                                            <label>Default value</label>
                                            <input type="text" @bind="f.DefaultValue" @bind:event="oninput" />
                                        </div>
                                        <div>
                                            <label>Placeholder</label>
                                            <input type="text" @bind="f.Placeholder" @bind:event="oninput" />
                                        </div>
                                        <div>
                                            <label>Help text</label>
                                            <input type="text" @bind="f.HelpText" @bind:event="oninput" />
                                        </div>
                                        <div>
                                            <label>Min length</label>
                                            <input type="number" @bind="f.MinLength" @bind:event="oninput" />
                                        </div>
                                        <div>
                                            <label>Max length</label>
                                            <input type="number" @bind="f.MaxLength" @bind:event="oninput" />
                                        </div>
                                        <div>
                                            <label>Min (number type)</label>
                                            <input type="number" @bind="f.Min" @bind:event="oninput" />
                                        </div>
                                        <div>
                                            <label>Max (number type)</label>
                                            <input type="number" @bind="f.Max" @bind:event="oninput" />
                                        </div>
                                        <div>
                                            <label>Pattern (regex)</label>
                                            <input type="text" @bind="f.Pattern" @bind:event="oninput" />
                                        </div>
                                        <div>
                                            <label>Error message</label>
                                            <input type="text" @bind="f.ErrorMessage" @bind:event="oninput" />
                                        </div>
                                        <div>
                                            <label>Group name</label>
                                            <input type="text" @bind="f.GroupName" @bind:event="oninput" />
                                        </div>
                                        <div>
                                            <label>Visible when field</label>
                                            <select @bind="f.VisibleWhenField">
                                                <option value="">-- none --</option>
                                                @foreach (var other in _formFields.Where(x => x != f && !string.IsNullOrWhiteSpace(x.Name)))
                                                {
                                                    <option value="@other.Name">@other.Name</option>
                                                }
                                            </select>
                                        </div>
                                        <div>
                                            <label>Visible when equals</label>
                                            <input type="text" @bind="f.VisibleWhenEquals" @bind:event="oninput" />
                                        </div>
                                        <div>
                                            <label>Step (wizard page)</label>
                                            <input type="number" min="1" @bind="f.Step" @bind:event="oninput" />
                                        </div>
                                    </div>
                                </details>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        <button class="secondary" @onclick="AddField">Add field</button>
    </div>

    <div class="panel">
        <h2>Preview</h2>
        <p style="color:#868e96;font-size:.85rem">Live preview of the current (unsaved) form fields as an end user would see them. Not connected to any run.</p>
        @if (_formFields.Count == 0)
        {
            <p>No fields yet.</p>
        }
        else
        {
            string? lastGroup = null;
            @foreach (var f in _formFields)
            {
                if (!FormFieldValidator.IsVisible(f, _previewValues)) continue;
                var showGroupHeader = f.GroupName != lastGroup && !string.IsNullOrWhiteSpace(f.GroupName);
                lastGroup = f.GroupName;
                if (showGroupHeader)
                {
                    <h3 style="margin-top:1rem">@f.GroupName</h3>
                }
                <div style="margin-bottom:.9rem">
                    <label style="margin-top:.4rem">
                        @f.Label
                        @if (f.Required)
                        {
                            <span style="color:var(--err)">*</span>
                        }
                        @if (f.Step > 1)
                        {
                            <span class="badge" style="margin-left:.4rem">Step @f.Step</span>
                        }
                    </label>
                    @if (!string.IsNullOrWhiteSpace(f.HelpText))
                    {
                        <p style="color:#868e96;font-size:.78rem;margin:.1rem 0">@f.HelpText</p>
                    }
                    @if (f.Type == "textarea")
                    {
                        <textarea placeholder="@f.Placeholder" value="@GetPreviewValue(f.Name)" @oninput="e => SetPreviewValue(f.Name, e)"></textarea>
                    }
                    else if (f.Type == FormFieldTypeSelect)
                    {
                        <select value="@GetPreviewValue(f.Name)" @onchange="e => SetPreviewValue(f.Name, e)">
                            <option value="">-- select --</option>
                            @foreach (var o in f.Options)
                            {
                                <option value="@o">@o</option>
                            }
                        </select>
                    }
                    else if (f.Type == "checkbox")
                    {
                        <input type="checkbox" style="width:auto" checked="@(GetPreviewValue(f.Name) == "true")" @onchange="e => SetPreviewValue(f.Name, e)" />
                    }
                    else
                    {
                        var inputType = f.Type is "number" or "date" or "email" or "url" ? f.Type : "text";
                        <input type="@inputType" placeholder="@f.Placeholder" value="@GetPreviewValue(f.Name)" @oninput="e => SetPreviewValue(f.Name, e)" />
                    }
                </div>
            }
        }
    </div>
    }

    @if (_activeTab == "chat")
    {
    <div class="panel">
        <h2>Test Chat (draft)</h2>
        <div class="chat-box">
            @foreach (var m in _chatMessages)
            {
                <div class="chat-msg @m.Role">
                    <div class="role">@m.Role</div>
                    <div class="content">
                        @if (m.Role == "assistant" && DatabaseResultTable.TryParse(m.Content, out var _tCols, out var _tRows, out _))
                        {
                            @if (_tRows.Count == 0)
                            {
                                <span>No rows.</span>
                            }
                            else
                            {
                                <div class="chat-result-table-wrap">
                                    <table class="chat-result-table">
                                        <thead><tr>@foreach (var c in _tCols) { <th>@c</th> }</tr></thead>
                                        <tbody>
                                            @foreach (var row in _tRows)
                                            {
                                                <tr>@foreach (var c in _tCols) { <td>@(row.TryGetValue(c, out var v) ? v : "")</td> }</tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        }
                        else
                        {
                            @m.Content
                        }
                    </div>
                </div>
            }
            @if (_streaming.Length > 0)
            {
                <div class="chat-msg assistant">
                    <div class="role">assistant</div>
                    <div class="content">@_streaming</div>
                </div>
            }
        </div>
        <div style="display:flex;gap:.5rem;margin-top:.75rem">
            <input type="text" @bind="_chatInput" @bind:event="oninput" placeholder="Type a message..." style="flex:1" />
            <button class="primary" style="margin-top:0" @onclick="SendAsync" disabled="@_sending">Send</button>
        </div>
    </div>
    }

    @if (_activeTab == "logs")
    {
    <div class="panel">
        <h2>Execution Logs</h2>
        <table>
            <thead><tr><th>Execution</th><th>Status</th><th>Started</th><th>Duration</th><th>Steps</th><th>Error</th></tr></thead>
            <tbody>
                @foreach (var l in _logs ?? new())
                {
                    <tr style="cursor:pointer" @onclick="() => ToggleLog(l.ExecutionId)">
                        <td>@( _expandedLogs.Contains(l.ExecutionId) ? "▾" : "▸" ) <code>@l.ExecutionId[..8]</code></td>
                        <td>@l.Status</td>
                        <td>@l.StartedAt.ToString("HH:mm:ss")</td>
                        <td>@((l.CompletedAt - l.StartedAt)?.TotalSeconds.ToString("F1") ?? "…")s</td>
                        <td>@l.Steps.Count</td>
                        <td>@l.Error</td>
                    </tr>
                    @if (_expandedLogs.Contains(l.ExecutionId))
                    {
                        <tr>
                            <td colspan="6" style="background:rgba(255,255,255,.03);padding:.5rem 1rem">
                                <table style="width:100%">
                                    <thead><tr><th>Node</th><th>Type</th><th>Status</th><th>Duration</th><th>Detail</th><th>Error</th></tr></thead>
                                    <tbody>
                                        @foreach (var s in l.Steps)
                                        {
                                            <tr>
                                                <td><code>@s.NodeId</code></td>
                                                <td>@s.NodeType</td>
                                                <td>@s.Status</td>
                                                <td>@((s.CompletedAt - s.StartedAt)?.TotalSeconds.ToString("F2") ?? "…")s</td>
                                                <td>@s.Detail</td>
                                                <td>@s.Error</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    }
}

<style>
    .agent-tabs {
        display: flex;
        gap: .25rem;
        margin: .75rem 0 1rem;
        border-bottom: 1px solid var(--hairline, #e5e4e0);
        flex-wrap: wrap;
    }
    .agent-tab-btn {
        background: none;
        border: none;
        border-bottom: 2px solid transparent;
        padding: .55rem .9rem;
        font-size: .85rem;
        font-weight: 600;
        color: var(--ink-3, #8b8a92);
        cursor: pointer;
        margin-bottom: -1px;
    }
    .agent-tab-btn:hover { color: var(--ink-1, #16161a); }
    .agent-tab-btn.active { color: var(--accent, #3b5bdb); border-bottom-color: var(--accent, #3b5bdb); }
</style>

@code {
    [Parameter] public Guid Id { get; set; }
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthState { get; set; }

    private Agent? Agent;
    private bool _canEdit;
    private string _activeTab = "build";
    private bool _canManageSharing;
    private string _newCollaboratorUsername = "";
    private string? _shareError;
    private List<Agent>? _allAgents;
    private List<ModelProviderConfig>? _allProviders;
    private List<DatabaseConnectionConfig>? _allConnections;
    private List<IntegratorSummary>? _allIntegrators;
    private string _providerName = "";
    private string _modelName = "";
    private string? _providerMessage;
    private List<(GraphComponentSummary Summary, WorkflowGraphDto Graph)>? _availableComponents;
    private WorkflowGraphDto _graph = new();
    private WorkflowNodeDto? _selectedNode;
    private GraphEditor? _editor;
    private string DraftStatus = "";
    private int _maxSteps = 100;
    private bool _scheduleEnabled;
    private int? _scheduleIntervalMinutes;
    private string _scheduleInput = "";
    private string? _scheduleMessage;
    private string _envVarsText = "";
    private string? _envVarsMessage;
    private List<FormField> _formFields = new();
    private string _formResultMode = "inline";
    private string? _formResultTarget;
    private bool _formResultMarkdown;
    private Dictionary<string, string> _previewValues = new();
    private ValidationResultDto? _validation;
    private string? _publishMessage;

    private List<(string Role, string Content)> _chatMessages = new();
    private string _chatInput = "";
    private string _streaming = "";
    private bool _sending;
    private string? _conversationId;
    private List<ExecutionLog>? _logs;
    private HashSet<string> _expandedLogs = new();
    private string? _newApiKey;
    private List<Document>? _documents;
    private string? _documentError;

    private IEnumerable<AgentVersion> _publishedVersions =>
        Agent?.Versions.Where(v => v.Status == AgentVersionStatus.Published).OrderByDescending(v => v.Version)
        ?? Enumerable.Empty<AgentVersion>();

    private IEnumerable<AgentVersion> _unpublishedVersions =>
        Agent?.Versions.Where(v => v.Status == AgentVersionStatus.Unpublished).OrderByDescending(v => v.Version)
        ?? Enumerable.Empty<AgentVersion>();

    private string _diffFrom = "";
    private string _diffTo = "";
    private GraphDiffResult? _diffResult;

    /// <summary>"Draft" plus every version, newest first — the same set a user would naturally
    /// want to diff against ("what did I just change before publishing").</summary>
    private List<string> _diffOptions =>
        (Agent?.Draft is null ? Enumerable.Empty<string>() : new[] { "Draft" })
            .Concat(Agent?.Versions.OrderByDescending(v => v.Version).Select(v => $"v{v.Version}") ?? Enumerable.Empty<string>())
            .ToList();

    private WorkflowGraph? GraphFor(string option)
    {
        if (Agent is null || string.IsNullOrEmpty(option)) return null;
        if (option == "Draft") return Agent.Draft?.Graph;
        var version = int.Parse(option.TrimStart('v'));
        return Agent.Versions.FirstOrDefault(v => v.Version == version)?.Graph;
    }

    private void RunDiff()
    {
        var from = GraphFor(_diffFrom);
        var to = GraphFor(_diffTo);
        _diffResult = from is null || to is null ? null : GraphDiff.Compare(GraphMapper.ToDto(from), GraphMapper.ToDto(to));
    }

    private static string DiffColor(string changeKind) => changeKind switch
    {
        "added" => "#2f9e44",
        "removed" => "#c92a2a",
        _ => "#e8590c"
    };

    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private async Task CopyLink(int version)
    {
        var url = $"{Nav.BaseUri.TrimEnd('/')}/chat/{Agent!.Id}/{version}?key=YOUR_API_KEY";
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
    }

    private async Task CopyFormLink(int version)
    {
        var url = $"{Nav.BaseUri.TrimEnd('/')}/run/{Agent!.Id}/{version}?key=YOUR_API_KEY";
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
    }

    private const string FormFieldTypeSelect = "select";

    private void AddField() =>
        _formFields.Add(new FormField { Name = $"field{_formFields.Count + 1}", Label = "Field" });

    private static void SetOptions(FormField f, ChangeEventArgs e) =>
        f.Options = ((string?)e.Value ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

    private void MoveFieldUp(FormField f)
    {
        var idx = _formFields.IndexOf(f);
        if (idx <= 0) return;
        (_formFields[idx - 1], _formFields[idx]) = (_formFields[idx], _formFields[idx - 1]);
    }

    private void MoveFieldDown(FormField f)
    {
        var idx = _formFields.IndexOf(f);
        if (idx < 0 || idx >= _formFields.Count - 1) return;
        (_formFields[idx + 1], _formFields[idx]) = (_formFields[idx], _formFields[idx + 1]);
    }

    private string GetPreviewValue(string name) => _previewValues.GetValueOrDefault(name, "");

    private void SetPreviewValue(string name, ChangeEventArgs e) =>
        _previewValues[name] = e.Value switch
        {
            bool b => b ? "true" : "false",
            null => "",
            var v => v.ToString() ?? ""
        };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        Agent = await Api.GetAgentAsync(Id);
        if (Agent is not null)
        {
            _canEdit = await ComputeCanEditAsync(Agent);
            _scheduleEnabled = Agent.ScheduleEnabled;
            _scheduleIntervalMinutes = Agent.ScheduleIntervalMinutes;
            _scheduleInput = Agent.ScheduleInput;
            _envVarsText = string.Join("\n", Agent.EnvironmentVariables.Select(kv => $"{kv.Key}={kv.Value}"));
            _providerName = Agent.ModelProviderName;
            _modelName = Agent.ModelName;
        }
        if (Agent?.Draft is not null)
        {
            _graph = GraphMapper.ToDto(Agent.Draft.Graph);
            DraftStatus = Agent.Draft.Status.ToString();
            _maxSteps = Agent.Draft.MaxSteps;
            _formFields = Agent.Draft.FormFields;
            _formResultMode = Agent.Draft.FormResultMode;
            _formResultTarget = Agent.Draft.FormResultTarget;
            _formResultMarkdown = Agent.Draft.FormResultMarkdown;
        }
        _logs = await Api.ListLogsAsync(Id);
        _documents = await Api.ListDocumentsAsync(Id);
        _allAgents = await Api.ListAgentsAsync();
        _allProviders = await Api.ListProvidersAsync();
        _allConnections = Api.ListDatabaseConnections();
        _allIntegrators = Api.ListIntegrators();
        _availableComponents = await Api.ListGraphComponentsWithGraphsAsync();

        if (_diffOptions.Count > 1)
        {
            _diffFrom = _diffOptions[1]; // newest version (or "Draft" itself if there's only Draft + one version)
            _diffTo = _diffOptions[0];
            RunDiff();
        }
    }

    private async Task UploadDocumentAsync(InputFileChangeEventArgs e)
    {
        _documentError = null;
        try
        {
            const long maxSize = 5 * 1024 * 1024; // 5 MB — plain text, no need for more
            await using var stream = e.File.OpenReadStream(maxSize);
            await Api.UploadDocumentAsync(Id, e.File.Name, stream);
            _documents = await Api.ListDocumentsAsync(Id);
        }
        catch (Exception ex)
        {
            _documentError = ex.Message;
        }
    }

    private async Task DeleteDocumentAsync(Guid documentId)
    {
        _documentError = null;
        try
        {
            await Api.DeleteDocumentAsync(documentId);
            _documents = await Api.ListDocumentsAsync(Id);
        }
        catch (Exception ex)
        {
            _documentError = ex.Message;
        }
    }

    private void OnGraphChanged(WorkflowGraphDto graph)
    {
        _graph = graph;
        _selectedNode = _editor?.SelectedNode;
    }

    private void OnNodeChanged(WorkflowNodeDto node)
    {
        var idx = _graph.Nodes.FindIndex(n => n.Id == node.Id);
        if (idx >= 0) _graph.Nodes[idx] = node;
    }

    private async Task SaveScheduleAsync()
    {
        try
        {
            await Api.UpdateScheduleAsync(Id, _scheduleEnabled, _scheduleIntervalMinutes, _scheduleInput);
            Agent = await Api.GetAgentAsync(Id);
            _scheduleMessage = "Saved.";
        }
        catch (Exception ex)
        {
            _scheduleMessage = ex.Message;
        }
    }

    /// <summary>Fills in the provider's own DefaultModel when a provider is picked and the
    /// Model field is still empty — otherwise picking a provider and clicking Save with no
    /// typed model throws "Provider and model name are required." with no clue why.</summary>
    private void OnProviderSelected()
    {
        if (!string.IsNullOrWhiteSpace(_modelName)) return;
        var provider = (_allProviders ?? new()).FirstOrDefault(p => p.Name == _providerName);
        if (provider is not null && !string.IsNullOrWhiteSpace(provider.DefaultModel))
            _modelName = provider.DefaultModel;
    }

    private async Task SaveProviderAsync()
    {
        try
        {
            await Api.UpdateAgentProviderAsync(Id, _providerName, _modelName);
            Agent = await Api.GetAgentAsync(Id);
            _providerMessage = "Saved.";
        }
        catch (Exception ex)
        {
            _providerMessage = ex.Message;
        }
    }

    private async Task<bool> ComputeCanEditAsync(Agent agent)
    {
        if (AuthState is null) return false; // fail-closed: no auth info, no access
        var state = await AuthState;
        if (!Guid.TryParse(state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var userId)) return false;
        var roleStr = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
        var role = Enum.TryParse<UserRole>(roleStr, out var r) ? r : UserRole.Editor;
        var currentUser = new User { Id = userId, Username = state.User.Identity?.Name ?? "", Role = role };
        _canManageSharing = role == UserRole.Admin || agent.OwnerId == currentUser.Id;
        return AgentAccess.CanEdit(agent, currentUser);
    }

    private async Task AddCollaboratorAsync()
    {
        _shareError = null;
        if (string.IsNullOrWhiteSpace(_newCollaboratorUsername)) return;
        try
        {
            await Api.AddCollaboratorAsync(Id, _newCollaboratorUsername.Trim());
            _newCollaboratorUsername = "";
            Agent = await Api.GetAgentAsync(Id);
        }
        catch (Exception ex)
        {
            _shareError = ex.Message;
        }
    }

    private async Task RemoveCollaboratorAsync(Guid userId)
    {
        await Api.RemoveCollaboratorAsync(Id, userId);
        Agent = await Api.GetAgentAsync(Id);
    }

    private async Task SaveEnvironmentVariablesAsync()
    {
        try
        {
            var dict = new Dictionary<string, string>();
            foreach (var line in _envVarsText.Split('\n'))
            {
                var trimmed = line.Trim();
                if (trimmed.Length == 0) continue;
                var idx = trimmed.IndexOf('=');
                if (idx > 0) dict[trimmed[..idx].Trim()] = trimmed[(idx + 1)..].Trim();
            }
            await Api.UpdateEnvironmentVariablesAsync(Id, dict);
            Agent = await Api.GetAgentAsync(Id);
            _envVarsMessage = "Saved.";
        }
        catch (Exception ex)
        {
            _envVarsMessage = ex.Message;
        }
    }

    private async Task OnComponentSaveRequested((string Name, WorkflowGraphDto Graph) req)
    {
        await Api.SaveGraphComponentAsync(req.Name, req.Graph);
        _availableComponents = await Api.ListGraphComponentsWithGraphsAsync();
    }

    private async Task OnComponentDeleteRequested(Guid id)
    {
        await Api.DeleteGraphComponentAsync(id);
        _availableComponents = await Api.ListGraphComponentsWithGraphsAsync();
    }

    private async Task SaveAsync()
    {
        _validation = await Api.SaveDraftAsync(Id, _graph, _maxSteps, _formFields, _formResultMode, _formResultTarget, _formResultMarkdown);
        DraftStatus = _validation.IsValid ? "Validated" : "Draft";
    }

    private async Task PublishAsync()
    {
        try
        {
            var v = await Api.PublishAsync(Id);
            _publishMessage = $"Published v{v.Version}.";
            _validation = null;
            await LoadAsync();
        }
        catch (InvalidOperationException ex)
        {
            _publishMessage = ex.Message;
        }
    }

    private void ToggleLog(string executionId)
    {
        if (!_expandedLogs.Remove(executionId))
            _expandedLogs.Add(executionId);
    }

    private async Task CopyApiKey() =>
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", _newApiKey);

    private async Task RegenerateKeyAsync()
    {
        try
        {
            _newApiKey = await Api.RegenerateApiKeyAsync(Id);
            _publishMessage = "API key regenerated.";
        }
        catch (Exception ex)
        {
            _publishMessage = ex.Message;
        }
    }

    private async Task UnpublishAsync(int version)
    {
        try
        {
            await Api.UnpublishAsync(Id, version);
            _publishMessage = $"Unpublished v{version}.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _publishMessage = ex.Message;
        }
    }

    private async Task RepublishAsync(int version)
    {
        try
        {
            var v = await Api.RepublishAsync(Id, version);
            _publishMessage = $"Republished v{version} as v{v.Version}.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _publishMessage = ex.Message;
        }
    }

    private async Task SendAsync()
    {
        if (Agent is null || string.IsNullOrWhiteSpace(_chatInput)) return;
        _sending = true;
        var message = _chatInput;
        _chatInput = "";
        _chatMessages.Add(("user", message));
        _streaming = "";

        try
        {
            var ctx = await Api.StartTestChatAsync(Agent, _conversationId);
            if (ctx is null)
            {
                _chatMessages.Add(("system", "No provider or version configured."));
                return;
            }
            var (conversation, provider, version) = ctx.Value;
            _conversationId = conversation.ConversationId;

            await foreach (var chunk in Api.RunTestChatAsync(Agent, version, provider, conversation, message))
            {
                _streaming += chunk;
                StateHasChanged();
            }
            _chatMessages.Add(("assistant", _streaming));
            _streaming = "";
            _logs = await Api.ListLogsAsync(Id);
        }
        catch (Exception ex)
        {
            _chatMessages.Add(("system", ex.Message));
        }
        finally
        {
            _sending = false;
        }
    }
}
