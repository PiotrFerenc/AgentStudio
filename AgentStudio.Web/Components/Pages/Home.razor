@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@inject AgentStudio.Web.Services.StudioApiClient Api
@inject NavigationManager Nav
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Agents</PageTitle>

<div class="panel">
    <div style="display:flex;justify-content:space-between;align-items:center">
        <h2 style="margin:0">Agents</h2>
        <button class="primary" @onclick="OpenCreate">New agent</button>
    </div>
    @if (_agents is null)
    {
        <p>Loading...</p>
    }
    else if (_agents.Count == 0)
    {
        <p>No agents yet. Create the first one below.</p>
    }
    else
    {
        <table>
            <thead><tr><th>Name</th><th>Owner</th><th>Model</th><th>Versions</th><th>Created</th><th></th></tr></thead>
            <tbody>
                @foreach (var a in _agents)
                {
                    <tr>
                        <td>@a.Name</td>
                        <td style="color:#868e96;font-size:.85rem">@(a.OwnerUsername ?? "—")</td>
                        <td>@a.ModelProviderName / @a.ModelName</td>
                        <td>
                            @foreach (var v in a.Versions.OrderByDescending(v => v.Version))
                            {
                                <span class="badge @(v.Status == AgentStudio.Domain.AgentVersionStatus.Published ? "published" : "")">v@v.Version @v.Status</span>
                            }
                        </td>
                        <td>@a.CreatedAt.ToString("yyyy-MM-dd")</td>
                        <td><a href="/agents/@a.Id">Open</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@if (_showCreate)
{
    <div class="modal-backdrop" @onclick="CloseCreate">
        <div class="modal" @onclick:stopPropagation>
            <div class="modal-header">
                <h2>Create Agent</h2>
                <button class="modal-close" @onclick="CloseCreate" aria-label="Close">×</button>
            </div>
            <label>Start from</label>
            <div class="template-picker">
                <button type="button" class="template-card @(_selectedTemplateId is null ? "active" : "")" @onclick="() => _selectedTemplateId = null">
                    <strong>Blank</strong>
                    <span>Start → Prompt → End</span>
                </button>
                @foreach (var t in _templates)
                {
                    <button type="button" class="template-card @(_selectedTemplateId == t.Id ? "active" : "")" @onclick="() => _selectedTemplateId = t.Id">
                        <strong>@t.Name</strong>
                        <span>@t.Description</span>
                    </button>
                }
            </div>
            <label>Name</label>
            <input type="text" @bind="_name" />
            <label>Description</label>
            <input type="text" @bind="_description" />
            <label>System instructions</label>
            <textarea @bind="_instructions"></textarea>
            <label>Model provider</label>
            <select @bind="_providerName">
                <option value="">-- select --</option>
                @foreach (var p in _providers ?? new())
                {
                    <option value="@p.Name">@p.Name (@p.BaseUrl)</option>
                }
            </select>
            <label>Model name</label>
            <input type="text" @bind="_modelName" placeholder="e.g. llama3.1, qwen2.5" />
            <br />
            <button class="primary" @onclick="CreateAsync" disabled="@_creating">Create</button>
            @if (_createdKey is not null)
            {
                <div class="panel" style="background:#fff3bf;margin-top:1rem">
                    <strong>API key (shown once):</strong>
                    <code>@_createdKey</code>
                </div>
            }
        </div>
    </div>
}

<style>
    .modal-backdrop {
        position: fixed; inset: 0; background: rgba(0,0,0,.4);
        display: flex; align-items: center; justify-content: center;
        z-index: 1000;
    }
    .modal {
        background: var(--paper, #fff); border-radius: 10px;
        padding: 1.25rem 1.5rem; width: min(560px, 92vw);
        max-height: 88vh; overflow-y: auto;
        box-shadow: 0 12px 40px rgba(0,0,0,.25);
    }
    .modal-header { display: flex; justify-content: space-between; align-items: center; }
    .modal-header h2 { margin: 0; }
    .modal-close {
        background: none; border: none; font-size: 1.4rem; line-height: 1;
        cursor: pointer; color: var(--ink-3, #8b8a92); padding: 0 .25rem;
    }
    .modal-close:hover { color: var(--ink-1, #16161a); }
    .template-picker { display: flex; flex-direction: column; gap: .4rem; margin-bottom: .75rem; }
    .template-card {
        text-align: left; background: var(--paper, #fff); border: 1px solid var(--hairline, #e5e4e0);
        border-radius: 8px; padding: .55rem .75rem; cursor: pointer; display: flex; flex-direction: column; gap: .15rem;
    }
    .template-card strong { font-size: .88rem; }
    .template-card span { font-size: .78rem; color: var(--ink-3, #8b8a92); }
    .template-card.active { border-color: var(--accent, #3b5bdb); background: color-mix(in srgb, var(--accent, #3b5bdb) 8%, var(--paper, #fff)); }
</style>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private List<AgentStudio.Domain.Agent>? _agents;
    private List<AgentStudio.Domain.ModelProviderConfig>? _providers;
    private string _name = "";
    private string _description = "";
    private string _instructions = "";
    private string _providerName = "";
    private string _modelName = "";
    private string? _createdKey;
    private bool _creating;
    private bool _showCreate;
    private List<AgentStudio.Contracts.AgentTemplate> _templates = new();
    private string? _selectedTemplateId;

    protected override async Task OnInitializedAsync()
    {
        _agents = await Api.ListAgentsAsync();
        _providers = await Api.ListProvidersAsync();
        _templates = Api.ListAgentTemplates();
    }

    private void OpenCreate() => _showCreate = true;

    private void CloseCreate()
    {
        _showCreate = false;
        _name = _description = _instructions = _providerName = _modelName = "";
        _createdKey = null;
        _selectedTemplateId = null;
    }

    private async Task CreateAsync()
    {
        _creating = true;
        try
        {
            Guid? ownerId = null;
            string? ownerUsername = null;
            if (AuthState is not null)
            {
                var state = await AuthState;
                if (Guid.TryParse(state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var id))
                    ownerId = id;
                ownerUsername = state.User.Identity?.Name;
            }
            var (agent, key) = await Api.CreateAgentAsync(_name, _description, _instructions, _providerName, _modelName, ownerId, ownerUsername, _selectedTemplateId);
            _createdKey = key;
            _agents = await Api.ListAgentsAsync();
        }
        finally
        {
            _creating = false;
        }
    }
}
