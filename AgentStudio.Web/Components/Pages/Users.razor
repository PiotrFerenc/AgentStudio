@page "/users"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@inject AgentStudio.Web.Services.StudioApiClient Api
@using AgentStudio.Domain

<PageTitle>Users</PageTitle>

<div class="panel">
    <h2>Users</h2>
    <p style="color:#868e96;font-size:.85rem">Accounts are defined in appsettings.json's "Users" array — edit the file and restart to add, remove, or change one.</p>
    @if (_users is null)
    {
        <p>Loading...</p>
    }
    else
    {
        <table>
            <thead><tr><th>Username</th><th>Role</th></tr></thead>
            <tbody>
                @foreach (var u in _users)
                {
                    <tr>
                        <td>@u.Username</td>
                        <td>@u.Role</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<User>? _users;

    protected override async Task OnInitializedAsync() => _users = await Api.ListUsersAsync();
}
