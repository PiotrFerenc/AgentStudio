@page "/run/{AgentId:guid}/{Version:int}"
@layout AgentStudio.Web.Components.Layout.ChatLayout
@rendermode InteractiveServer
@inject AgentStudio.Application.IAgentRepository Agents
@inject AgentStudio.Application.IProviderRepository Providers
@inject AgentStudio.Application.AgentService AgentService
@inject AgentStudio.Application.WorkflowRunner Runner
@inject Microsoft.AspNetCore.Components.NavigationManager Nav
@inject IHttpClientFactory HttpClientFactory
@using AgentStudio.Domain
@using System.Text.RegularExpressions

@if (_notFound)
{
    <div class="chat-error">
        <h2>Agent not available</h2>
        <p>@_errorMessage</p>
    </div>
}
else if (_needsKey)
{
    <div class="chat-key-gate">
        <div class="chat-key-box">
            <h2>@(_agent?.Name ?? "Agent")</h2>
            <p>This form requires an access key.</p>
            <input type="password" @bind="_keyInput" @bind:event="oninput" placeholder="Access key" @onkeydown="OnKeyDown" />
            <button @onclick="SubmitKey">Enter</button>
            @if (_keyError)
            {
                <p class="chat-key-error">Invalid key. Try again.</p>
            }
        </div>
    </div>
}
else if (_agent is not null && _version is not null)
{
    <div class="chat-page">
        <header class="chat-header">
            <strong>@_agent.Name</strong>
            <span class="chat-header-sub">v@Version · form · powered by AgentStudio</span>
        </header>
        <div class="chat-messages run-messages">
            <div class="run-form">
                @if (_version.FormFields.Count == 0)
                {
                    <p class="chat-empty">This version has no form fields configured.</p>
                }
                else
                {
                    var stepFields = _version.FormFields.Where(f => f.Step == _currentStep).ToList();
                    string? prevGroup = null;
                    @foreach (var f in stepFields)
                    {
                        if (!FormFieldValidator.IsVisible(f, _values)) continue;
                        if (!string.IsNullOrEmpty(f.GroupName) && f.GroupName != prevGroup)
                        {
                            <h3 class="run-group-header">@f.GroupName</h3>
                        }
                        prevGroup = f.GroupName;
                        <div class="run-field">
                            <label>@f.Label @if (f.Required) { <span class="run-required">*</span> }</label>
                            @if (f.Type == "textarea")
                            {
                                <textarea @bind="_values[f.Name]" @bind:event="oninput" placeholder="@f.Placeholder"></textarea>
                            }
                            else if (f.Type == "select")
                            {
                                <select @bind="_values[f.Name]">
                                    <option value="">-- select --</option>
                                    @foreach (var o in f.Options)
                                    {
                                        <option value="@o">@o</option>
                                    }
                                </select>
                            }
                            else if (f.Type == "checkbox")
                            {
                                <input type="checkbox" class="run-checkbox"
                                       checked="@(_values.GetValueOrDefault(f.Name) == "true")"
                                       @onchange="@(e => _values[f.Name] = (bool)(e.Value ?? false) ? "true" : "false")" />
                            }
                            else
                            {
                                <input type="@InputTypeFor(f.Type)" @bind="_values[f.Name]" @bind:event="oninput" placeholder="@f.Placeholder" />
                            }
                            @if (!string.IsNullOrEmpty(f.HelpText))
                            {
                                <p class="run-help">@f.HelpText</p>
                            }
                        </div>
                    }
                    @if (_isWizard)
                    {
                        <div class="run-wizard-nav">
                            <button class="run-back" @onclick="GoBack" disabled="@(_currentStep <= 1 || _sending)">Back</button>
                            @if (_currentStep < _maxStep)
                            {
                                <button class="run-submit run-next" @onclick="GoNext" disabled="@_sending">Next</button>
                            }
                            else
                            {
                                <button class="run-submit" @onclick="SubmitAsync" disabled="@_sending">@(_sending ? "Running…" : "Run")</button>
                            }
                        </div>
                    }
                    else
                    {
                        <button class="run-submit" @onclick="SubmitAsync" disabled="@_sending">@(_sending ? "Running…" : "Run")</button>
                    }
                }
                @if (_errors.Count > 0)
                {
                    <ul class="run-error-list">
                        @foreach (var e in _errors)
                        {
                            <li>@e</li>
                        }
                    </ul>
                }
            </div>
            @if (_result is not null)
            {
                <div class="run-result">
                    <span class="run-result-label">Result</span>
                    @if (_version.FormResultMarkdown && !_result.Contains("[error]"))
                    {
                        <div class="run-result-body">@((MarkupString)RenderMarkdown(_result))</div>
                    }
                    else
                    {
                        <div class="run-result-body">@_result</div>
                    }
                </div>
            }
            else if (_sending)
            {
                <div class="run-result run-result-pending">
                    <span class="run-dot"></span><span class="run-dot"></span><span class="run-dot"></span>
                </div>
            }
        </div>
    </div>
}

<style>
    .run-messages { justify-content: flex-start; }
    .run-form {
        max-width: 480px;
        width: 100%;
        margin: 1.5rem auto 0;
        background: #fff;
        border: 1px solid #e5e4e0;
        border-radius: 12px;
        padding: 1.5rem 1.75rem 1.75rem;
    }
    .run-field { margin-bottom: 1.1rem; text-align: left; }
    .run-field:last-of-type { margin-bottom: 1.4rem; }
    .run-field label {
        display: block;
        font-size: .78rem;
        font-weight: 650;
        color: #57565e;
        margin-bottom: .4rem;
        letter-spacing: .01em;
    }
    .run-required { color: #e03131; }
    .run-field input,
    .run-field textarea,
    .run-field select {
        width: 100%;
        box-sizing: border-box;
        padding: .6rem .75rem;
        border: 1px solid #e5e4e0;
        border-radius: 8px;
        font-size: .9rem;
        font-family: inherit;
        color: #16161a;
        background: #fff;
        transition: border-color .12s, box-shadow .12s;
    }
    .run-field input[type="checkbox"] { width: auto; box-sizing: content-box; }
    .run-field textarea { min-height: 90px; resize: vertical; }
    .run-field input:focus,
    .run-field textarea:focus,
    .run-field select:focus {
        outline: none;
        border-color: #3b5bdb;
        box-shadow: 0 0 0 3px #edf0fd;
    }
    .run-help {
        font-size: .76rem;
        color: #8b8a92;
        margin: .35rem 0 0;
    }
    .run-group-header {
        font-size: .85rem;
        font-weight: 700;
        color: #16161a;
        margin: 1.4rem 0 .8rem;
        padding-bottom: .4rem;
        border-bottom: 1px solid #e5e4e0;
    }
    .run-group-header:first-child { margin-top: 0; }
    .run-submit {
        width: 100%;
        background: #16161a;
        color: #fff;
        border: 0;
        border-radius: 8px;
        padding: .7rem 1.15rem;
        cursor: pointer;
        font-size: .92rem;
        font-weight: 650;
        font-family: inherit;
        transition: background .12s;
    }
    .run-submit:hover:not(:disabled) { background: #2a2a31; }
    .run-submit:disabled { opacity: .5; cursor: default; }
    .run-wizard-nav { display: flex; gap: .6rem; }
    .run-wizard-nav .run-submit { flex: 1; }
    .run-back {
        flex: 1;
        background: #fff;
        color: #16161a;
        border: 1px solid #e5e4e0;
        border-radius: 8px;
        padding: .7rem 1.15rem;
        cursor: pointer;
        font-size: .92rem;
        font-weight: 650;
        font-family: inherit;
    }
    .run-back:disabled { opacity: .5; cursor: default; }
    .run-error-list {
        color: #e03131;
        font-size: .82rem;
        margin: .85rem 0 0;
        padding-left: 1.1rem;
        text-align: left;
    }
    .run-result {
        max-width: 480px;
        width: 100%;
        margin: 1rem auto 0;
        background: #f4f4f2;
        border: 1px solid #e5e4e0;
        border-radius: 12px;
        padding: 1rem 1.25rem 1.15rem;
    }
    .run-result-label {
        display: block;
        font-size: .68rem;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
        color: #8b8a92;
        margin-bottom: .4rem;
    }
    .run-result-body {
        white-space: pre-wrap;
        font-size: .9rem;
        line-height: 1.5;
        color: #16161a;
    }
    .run-result-body a { color: #3b5bdb; }
    .run-result-pending {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .3rem;
        padding: 1.1rem;
    }
    .run-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #8b8a92;
        animation: run-pulse 1.1s ease-in-out infinite;
    }
    .run-dot:nth-child(2) { animation-delay: .15s; }
    .run-dot:nth-child(3) { animation-delay: .3s; }
    @@keyframes run-pulse {
        0%, 80%, 100% { opacity: .25; transform: scale(.85); }
        40% { opacity: 1; transform: scale(1); }
    }
</style>

@code {
    [Parameter] public Guid AgentId { get; set; }
    [Parameter] public int Version { get; set; }
    [SupplyParameterFromQuery(Name = "key")] public string? QueryKey { get; set; }

    private Agent? _agent;
    private AgentVersion? _version;
    private ModelProviderConfig? _provider;

    private bool _notFound;
    private string _errorMessage = "";
    private bool _needsKey = true;
    private bool _keyError;
    private string _keyInput = "";

    private readonly Dictionary<string, string> _values = new();
    private bool _sending;
    private string? _result;
    private List<string> _errors = new();

    private int _currentStep = 1;
    private int _maxStep = 1;
    private bool _isWizard => _maxStep > 1;

    protected override async Task OnInitializedAsync()
    {
        _agent = await Agents.GetAsync(AgentId);
        if (_agent is null)
        {
            _notFound = true;
            _errorMessage = "This agent does not exist.";
            return;
        }

        _version = _agent.Versions.FirstOrDefault(v => v.Version == Version && v.Status == AgentVersionStatus.Published);
        if (_version is null)
        {
            _notFound = true;
            _errorMessage = $"Version {Version} is not published.";
            return;
        }

        _provider = await Providers.GetByNameAsync(_agent.ModelProviderName);
        foreach (var f in _version.FormFields)
            _values[f.Name] = f.DefaultValue ?? "";

        _maxStep = _version.FormFields.Count == 0 ? 1 : _version.FormFields.Max(f => f.Step);

        if (!string.IsNullOrWhiteSpace(QueryKey))
            await TryKeyAsync(QueryKey);
    }

    private async Task SubmitKey() => await TryKeyAsync(_keyInput);

    private async Task TryKeyAsync(string? key)
    {
        if (_agent is not null && AgentService.VerifyApiKey(_agent, key))
        {
            _needsKey = false;
            _keyError = false;
        }
        else
        {
            _keyError = true;
        }
        await Task.CompletedTask;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SubmitKey();
    }

    private static string InputTypeFor(string type) => type switch
    {
        "number" or "date" or "email" or "url" => type,
        _ => "text"
    };

    private void GoBack()
    {
        if (_currentStep > 1) _currentStep--;
        _errors.Clear();
    }

    private void GoNext()
    {
        if (_version is null) return;
        var stepFields = _version.FormFields.Where(f => f.Step == _currentStep).ToList();
        var errs = FormFieldValidator.Validate(stepFields, _values);
        if (errs.Count > 0)
        {
            _errors = errs;
            return;
        }
        _errors = new();
        _currentStep++;
    }

    private async Task SubmitAsync()
    {
        if (_agent is null || _version is null || _provider is null) return;

        var errs = FormFieldValidator.Validate(_version.FormFields, _values);
        if (errs.Count > 0)
        {
            _errors = errs;
            return;
        }

        _sending = true;
        _errors = new();
        _result = null;

        try
        {
            // One-shot, not persisted — a form run isn't a multi-turn conversation.
            var conversation = new ConversationState
            {
                ConversationId = $"form-{Guid.NewGuid():N}",
                AgentId = _agent.Id,
                AgentVersion = _version.Version
            };

            var buffer = new System.Text.StringBuilder();
            await foreach (var chunk in Runner.RunAsync(_agent, _version, _provider, conversation, "", formValues: _values))
                buffer.Append(chunk);

            var result = buffer.ToString();
            var success = !result.Contains("[error]");
            var mode = _version.FormResultMode; // anything other than "redirect"/"webhook" is treated as "inline" below

            if (success && mode == "redirect" && !string.IsNullOrWhiteSpace(_version.FormResultTarget))
            {
                var url = ExpandPlaceholders(_version.FormResultTarget, result, conversation.ConversationId, Runner.LastExecutionId);
                Nav.NavigateTo(url, forceLoad: true);
                return; // leaving the app — nothing left to render here
            }

            if (success && mode == "webhook" && !string.IsNullOrWhiteSpace(_version.FormResultTarget))
            {
                var url = ExpandPlaceholders(_version.FormResultTarget, result, conversation.ConversationId, Runner.LastExecutionId);
                try
                {
                    var client = HttpClientFactory.CreateClient("agentstudio-http-tool");
                    await client.PostAsJsonAsync(url, new { result, conversationId = conversation.ConversationId, executionId = Runner.LastExecutionId });
                }
                catch (Exception ex)
                {
                    result += $" (webhook delivery failed: {ex.Message})";
                }
                // A webhook target isn't necessarily the browser — the visitor still needs to
                // see their submission went through, so fall through to the inline result below.
            }

            _result = result;
        }
        catch (Exception ex)
        {
            _errors = new List<string> { ex.Message };
        }
        finally
        {
            _sending = false;
        }
    }

    private static string ExpandPlaceholders(string template, string result, string conversationId, string? executionId) =>
        template
            .Replace("{result}", Uri.EscapeDataString(result))
            .Replace("{conversationId}", Uri.EscapeDataString(conversationId))
            .Replace("{executionId}", Uri.EscapeDataString(executionId ?? ""));

    // Intentionally a minimal regex-based subset, not a CommonMark parser — this project has zero
    // new NuGet dependencies across 4 phases, and a form result only needs a handful of inline
    // styles. Escaping first (mandatory) is what keeps this safe against markup injection.
    private static string RenderMarkdown(string raw)
    {
        var s = System.Net.WebUtility.HtmlEncode(raw);
        s = Regex.Replace(s, @"\*\*(.+?)\*\*", "<strong>$1</strong>");
        s = Regex.Replace(s, @"\*(.+?)\*", "<em>$1</em>");
        s = Regex.Replace(s, "`(.+?)`", "<code>$1</code>");
        s = Regex.Replace(s, @"\[([^\]]+)\]\((https?://[^\s)]+)\)", "<a href=\"$2\" rel=\"noopener noreferrer\" target=\"_blank\">$1</a>");
        s = Regex.Replace(s, "(?m)^# (.+)$", "<h3>$1</h3>");
        s = s.Replace("\r\n", "\n");
        s = Regex.Replace(s, "\n\n+", "</p><p>");
        s = s.Replace("\n", "<br/>");
        return $"<p>{s}</p>";
    }
}
