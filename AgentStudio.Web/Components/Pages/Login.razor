@page "/login"
@layout AgentStudio.Web.Components.Layout.ChatLayout
@inject AgentStudio.Application.UserService Users
@inject NavigationManager Nav
@using Microsoft.AspNetCore.WebUtilities

<PageTitle>Sign in</PageTitle>

<div class="chat-key-gate">
    <div class="chat-key-box">
        <h2>AgentStudio</h2>
        <p>Sign in to the studio.</p>
        @if (_noUsers)
        {
            <p class="chat-key-error">No users configured. Add one to appsettings.json's "Users" array and restart.</p>
        }
        else
        {
            <form method="post" action="/auth/login">
                <input type="text" name="username" placeholder="Username" autofocus required />
                <input type="password" name="password" placeholder="Password" required />
                <button type="submit">Sign in</button>
            </form>
            @if (_error)
            {
                <p class="chat-key-error">Invalid username or password.</p>
            }
        }
    </div>
</div>

@code {
    private bool _error;
    private bool _noUsers;

    protected override async Task OnInitializedAsync()
    {
        // Accounts are entirely appsettings.json's "Users" array now — nothing to bootstrap,
        // just tell the operator if the file has none configured yet.
        _noUsers = !await Users.AnyUsersAsync();
        if (_noUsers) return;

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        _error = query.ContainsKey("error");
    }
}
