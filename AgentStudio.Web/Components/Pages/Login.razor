@page "/login"
@layout AgentStudio.Web.Components.Layout.ChatLayout
@inject AgentStudio.Application.UserService Users
@inject NavigationManager Nav
@using Microsoft.AspNetCore.WebUtilities

<PageTitle>Sign in</PageTitle>

<div class="chat-key-gate">
    <div class="chat-key-box">
        <h2>AgentStudio</h2>
        <p>Sign in to the studio.</p>
        <form method="post" action="/auth/login">
            <input type="text" name="username" placeholder="Username" autofocus required />
            <input type="password" name="password" placeholder="Password" required />
            <button type="submit">Sign in</button>
        </form>
        @if (_error)
        {
            <p class="chat-key-error">Invalid username or password.</p>
        }
    </div>
</div>

@code {
    private bool _error;

    protected override async Task OnInitializedAsync()
    {
        // Fresh install has no accounts yet — send the operator to create the first admin.
        if (!await Users.AnyUsersAsync())
        {
            Nav.NavigateTo("/setup");
            return;
        }

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        _error = query.ContainsKey("error");
    }
}
