@page "/database-connections"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@inject AgentStudio.Web.Services.StudioApiClient Api
@using AgentStudio.Domain

<PageTitle>Database Connections</PageTitle>

<div class="panel">
    <h2>Database Connections</h2>
    <p style="color:#868e96;font-size:.85rem">
        Defined in <code>appsettings.json</code> under <code>DatabaseConnections</code> — not
        editable here. Add, change or remove a connection by editing the config and restarting
        the app; connection strings are never shown in this list.
    </p>
    @if (_connections.Count == 0)
    {
        <p>No connections configured.</p>
    }
    else
    {
        <table>
            <thead><tr><th>Name</th><th>Provider</th><th>Read-only</th></tr></thead>
            <tbody>
                @foreach (var c in _connections)
                {
                    <tr>
                        <td>@c.Name</td>
                        <td>@c.Provider</td>
                        <td>@(c.ReadOnly ? "yes" : "no — writes allowed")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<DatabaseConnectionConfig> _connections = new();

    protected override void OnInitialized() => _connections = Api.ListDatabaseConnections();
}
