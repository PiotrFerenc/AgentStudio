@using AgentStudio.Contracts
@inject AgentStudio.Web.Services.StudioApiClient Api

@if (Node is null)
{
    <p style="color:#868e96">Select a node to edit its properties.</p>
}
else
{
    <h3>@Node.Type (@Node.Id)</h3>
    <label>Label</label>
    <input type="text" @bind="Node.Label" @bind:event="oninput" @bind:after="Changed" />

    @switch (Node.Type)
    {
        case "prompt":
            <label>Prompt template (use {input}, {variables.name})</label>
            <textarea @bind="PromptTemplate" @bind:event="oninput" @bind:after="Changed"></textarea>
            <label>Result variable</label>
            <input type="text" @bind="ResultVariable" @bind:event="oninput" @bind:after="Changed" />
            break;
        case "message":
            <label>Message text</label>
            <textarea @bind="MessageText" @bind:event="oninput" @bind:after="Changed"></textarea>
            break;
        case "condition":
            <label>Left (e.g. variables.status or input)</label>
            <input type="text" @bind="CondLeft" @bind:event="oninput" @bind:after="Changed" />
            <label>Operator</label>
            <select @bind="CondOperator" @bind:after="Changed">
                @foreach (var op in Operators)
                {
                    <option value="@op">@op</option>
                }
            </select>
            <label>Right (literal or variables.x)</label>
            <input type="text" @bind="CondRight" @bind:event="oninput" @bind:after="Changed" />
            break;
        case "http":
            <label>Method</label>
            <select @bind="HttpMethod" @bind:after="Changed">
                @foreach (var m in Methods)
                {
                    <option value="@m">@m</option>
                }
            </select>
            <label>URL</label>
            <input type="text" @bind="HttpUrl" @bind:event="oninput" @bind:after="Changed" />
            <label>JSON body (optional)</label>
            <textarea @bind="HttpBody" @bind:event="oninput" @bind:after="Changed"></textarea>
            <label>Timeout (seconds)</label>
            <input type="text" @bind="HttpTimeout" @bind:event="oninput" @bind:after="Changed" />
            <label>Retries</label>
            <input type="text" @bind="HttpRetries" @bind:event="oninput" @bind:after="Changed" />
            <label>Result variable</label>
            <input type="text" @bind="HttpResultVariable" @bind:event="oninput" @bind:after="Changed" />
            break;
        case "variable":
            <label>Variable name</label>
            <input type="text" @bind="VarName" @bind:event="oninput" @bind:after="Changed" />
            <label>Value</label>
            <input type="text" @bind="VarValue" @bind:event="oninput" @bind:after="Changed" />
            break;
        case "documentSearch":
            <label>Query (use {input}, {variables.name})</label>
            <input type="text" @bind="SearchQuery" @bind:event="oninput" @bind:after="Changed" />
            <label>Top K (number of chunks)</label>
            <input type="text" @bind="SearchTopK" @bind:event="oninput" @bind:after="Changed" />
            <label>Result variable</label>
            <input type="text" @bind="SearchResultVariable" @bind:event="oninput" @bind:after="Changed" />
            <p style="color:#868e96;font-size:.8rem">Searches this agent's uploaded documents (Documents tab). Requires the agent's provider to have an embedding model configured (Providers page).</p>
            break;
        case "subAgent":
            <label>Target agent</label>
            <select @bind="SubAgentTargetId" @bind:after="Changed">
                <option value="">-- select --</option>
                @foreach (var a in AvailableAgents ?? new())
                {
                    <option value="@a.Id">@a.Name</option>
                }
            </select>
            <label>Input (use {input}, {variables.name})</label>
            <input type="text" @bind="SubAgentInputTemplate" @bind:event="oninput" @bind:after="Changed" />
            <label>Result variable</label>
            <input type="text" @bind="SubAgentResultVariable" @bind:event="oninput" @bind:after="Changed" />
            <p style="color:#868e96;font-size:.8rem">Calls the target agent's published version as a one-shot step — its own conversation, not shared with this one. Needs at least one published version.</p>
            break;
        case "databaseQuery":
            <label>Connection</label>
            <select @bind="DbConnectionName" @bind:after="Changed">
                <option value="">-- select --</option>
                @foreach (var c in AvailableConnections ?? new())
                {
                    <option value="@c.Name">@c.Name @(c.ReadOnly ? "" : "(write)")</option>
                }
            </select>
            <label>SQL query (@@name placeholders — never {variables.x} directly, that's SQL injection)</label>
            <textarea @bind="DbQuery" @bind:event="oninput" @bind:after="Changed"></textarea>
            <label>Parameters (one per line: name=value, value supports {input}/{variables.x})</label>
            <textarea @bind="DbParametersText" @bind:after="Changed" placeholder="status=variables.status"></textarea>
            <label>Timeout (seconds)</label>
            <input type="text" @bind="DbTimeout" @bind:event="oninput" @bind:after="Changed" />
            <label>Result variable</label>
            <input type="text" @bind="DbResultVariable" @bind:event="oninput" @bind:after="Changed" />
            <p style="color:#868e96;font-size:.8rem">Result is a JSON array of rows, written to the variable. Read-only connections only allow a single SELECT.</p>
            break;
        case "jsonParse":
            <label>Input (JSON text — use {input}/{variables.x}, e.g. an earlier http/databaseQuery/integrator result)</label>
            <input type="text" @bind="JsonParseInput" @bind:event="oninput" @bind:after="Changed" />
            <label>Path (dot/bracket, e.g. data.items[0].name)</label>
            <input type="text" @bind="JsonParsePath" @bind:event="oninput" @bind:after="Changed" />
            <label>Result variable</label>
            <input type="text" @bind="JsonParseResultVariable" @bind:event="oninput" @bind:after="Changed" />
            <p style="color:#868e96;font-size:.8rem">Extracts one value out of a JSON blob. Fails clearly (not silently empty) if the input isn't valid JSON or the path doesn't exist.</p>
            break;
        case "expression":
            <label>Formula</label>
            <textarea @bind="ExpressionFormula" @bind:after="Changed" placeholder='IF({variables.age} &gt;= 18, "adult", "minor")'></textarea>
            <label>Result variable</label>
            <input type="text" @bind="ExpressionResultVariable" @bind:event="oninput" @bind:after="Changed" />
            <p style="color:#868e96;font-size:.8rem">
                Arithmetic <code>+ - * /</code>, comparisons <code>== != &lt; &gt; &lt;= &gt;=</code>, logic <code>&amp;&amp; || !</code>, parens.
                Functions: <code>IF(cond,a,b)</code>, <code>CONCAT(a,b,...)</code>, <code>LEN(s)</code>, <code>UPPER(s)</code>, <code>LOWER(s)</code>,
                <code>TRIM(s)</code>, <code>ROUND(n,digits)</code>, <code>ABS(n)</code>. Use <code>{input}</code>/<code>{variables.x}</code> for values —
                a numeric-looking variable is treated as a number automatically.
            </p>
            break;
        case "collectionGet":
            <label>Key</label>
            <input type="text" @bind="CollectionGetKey" @bind:event="oninput" @bind:after="Changed" placeholder="user-{variables.userId}" />
            <label>Default value (used when the key was never set)</label>
            <input type="text" @bind="CollectionGetDefault" @bind:event="oninput" @bind:after="Changed" />
            <label>Result variable</label>
            <input type="text" @bind="CollectionGetResultVariable" @bind:event="oninput" @bind:after="Changed" />
            <p style="color:#868e96;font-size:.8rem">Reads a key from this agent's persistent collection — survives across runs and conversations, unlike a normal variable.</p>
            break;
        case "collectionSet":
            <label>Key</label>
            <input type="text" @bind="CollectionSetKey" @bind:event="oninput" @bind:after="Changed" placeholder="user-{variables.userId}" />
            <label>Value</label>
            <input type="text" @bind="CollectionSetValue" @bind:event="oninput" @bind:after="Changed" />
            <p style="color:#868e96;font-size:.8rem">Writes a key to this agent's persistent collection. Both fields support {input}/{variables.x}.</p>
            break;
        case "integrator":
            <label>Integrator</label>
            <select @bind="IntegratorName" @bind:after="Changed">
                <option value="">-- select --</option>
                @foreach (var i in AvailableIntegrators ?? new())
                {
                    <option value="@i.Name">@i.Name — @i.Description</option>
                }
            </select>
            <label>Config (one per line: name=value, value supports {input}/{variables.x})</label>
            <textarea @bind="IntegratorConfigText" @bind:after="Changed" placeholder="projectId=42&#10;title=New issue"></textarea>
            <label>Result variable</label>
            <input type="text" @bind="IntegratorResultVariable" @bind:event="oninput" @bind:after="Changed" />
            <p style="color:#868e96;font-size:.8rem">Custom integration with an external system (GitLab, Jira, ...). New integrators are written as code, not configured here — see CLAUDE.md.</p>
            break;
        case "end":
            <label>Output template (optional)</label>
            <textarea @bind="EndOutput" @bind:event="oninput" @bind:after="Changed"></textarea>
            break;
        case "start":
            <p>Entry point of the workflow.</p>
            break;
        case "parallel":
            <p>Fan-out: link this node to 2+ targets (drag from its port, one connection at a time). All branches run concurrently and must reconverge at a single Join node.</p>
            break;
        case "join":
            <p>Fan-in: where a parallel split's branches reconverge. Link the split's branches here; continue the workflow from this node's own outgoing edge.</p>
            break;
    }

    @if (Node.Type is not ("start" or "parallel" or "join"))
    {
        <hr style="margin:1.2rem 0;border:none;border-top:1px solid #e5e4e0" />
        <h4>Test this node</h4>
        <label>Sample variables (one per line: name=value — "input" counts as a variable too)</label>
        <textarea @bind="_debugVarsText" placeholder="input=5"></textarea>
        <button @onclick="RunDebugAsync" disabled="@_debugRunning">@(_debugRunning ? "Running…" : "Run test")</button>
        <p style="color:#868e96;font-size:.8rem">Runs just this node against the graph you're currently editing (unsaved changes included) — nodes that call an LLM, HTTP endpoint or database make a real call. Not saved to /analytics or the execution log.</p>

        @if (_debugError is not null)
        {
            <p style="color:#c92a2a">@_debugError</p>
        }
        else if (_debugResult is not null)
        {
            <div style="border:1px solid #e5e4e0;border-radius:8px;padding:.75rem 1rem;margin-top:.5rem">
                <p style="color:@(_debugResult.Success ? "#2f9e44" : "#c92a2a");font-weight:600;margin:0 0 .5rem">
                    @(_debugResult.Success ? "OK" : "Failed") @(_debugResult.Detail is not null ? $"— {_debugResult.Detail}" : "")
                </p>
                @if (_debugResult.Error is not null)
                {
                    <p style="color:#c92a2a;margin:.25rem 0">@_debugResult.Error</p>
                }
                @if (!string.IsNullOrEmpty(_debugResult.EmittedText))
                {
                    <p style="margin:.25rem 0"><strong>Emitted:</strong> @_debugResult.EmittedText</p>
                }
                <details>
                    <summary>Variables after run</summary>
                    <ul>
                        @foreach (var kv in _debugResult.Variables)
                        {
                            <li><code>@kv.Key</code> = @kv.Value</li>
                        }
                    </ul>
                </details>
            </div>
        }
    }
}

@code {
    [Parameter] public WorkflowNodeDto? SelectedNode { get; set; }
    [Parameter] public EventCallback<WorkflowNodeDto> NodeChanged { get; set; }
    [Parameter] public List<AgentStudio.Domain.Agent>? AvailableAgents { get; set; }
    [Parameter] public List<AgentStudio.Domain.DatabaseConnectionConfig>? AvailableConnections { get; set; }
    [Parameter] public List<AgentStudio.Contracts.IntegratorSummary>? AvailableIntegrators { get; set; }
    [Parameter] public Guid AgentId { get; set; }
    [Parameter] public WorkflowGraphDto? Graph { get; set; }

    private string _debugVarsText = "";
    private bool _debugRunning;
    private string? _debugError;
    private AgentStudio.Application.NodeDebugResult? _debugResult;

    private async Task RunDebugAsync()
    {
        if (Node is null || Graph is null) return;
        _debugRunning = true;
        _debugError = null;
        _debugResult = null;
        try
        {
            var sample = ParseNameValueLines(_debugVarsText);
            _debugResult = await Api.DebugNodeAsync(AgentId, Graph, Node.Id, sample);
        }
        catch (Exception ex)
        {
            _debugError = ex.Message;
        }
        finally
        {
            _debugRunning = false;
        }
    }

    private static Dictionary<string, string> ParseNameValueLines(string text)
    {
        var dict = new Dictionary<string, string>();
        foreach (var line in text.Split('\n'))
        {
            var trimmed = line.Trim();
            if (trimmed.Length == 0) continue;
            var idx = trimmed.IndexOf('=');
            if (idx > 0) dict[trimmed[..idx].Trim()] = trimmed[(idx + 1)..].Trim();
        }
        return dict;
    }

    private WorkflowNodeDto? Node => SelectedNode;

    private static readonly string[] Operators = { "Equals", "NotEquals", "Contains", "StartsWith", "EndsWith", "GreaterThan", "LessThan", "GreaterOrEqual", "LessOrEqual" };
    private static readonly string[] Methods = { "GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS" };

    private string Get(string key, string fallback = "") =>
        Node is not null && Node.Props.TryGetValue(key, out var v) && v is not null ? v.ToString() ?? fallback : fallback;

    private void Put(string key, string value)
    {
        if (Node is not null) Node.Props[key] = value;
    }

    private string PromptTemplate { get => Get("promptTemplate"); set => Put("promptTemplate", value); }
    private string ResultVariable { get => Get("resultVariable", "llmResult"); set => Put("resultVariable", value); }
    private string MessageText { get => Get("text"); set => Put("text", value); }
    private string CondLeft { get => Get("left"); set => Put("left", value); }
    private string CondOperator { get => Get("operator", "Equals"); set => Put("operator", value); }
    private string CondRight { get => Get("right"); set => Put("right", value); }
    private string HttpMethod { get => Get("method", "GET"); set => Put("method", value); }
    private string HttpUrl { get => Get("url"); set => Put("url", value); }
    private string HttpBody { get => Get("body"); set => Put("body", value); }
    private string HttpTimeout { get => Get("timeoutSeconds", "30"); set => Put("timeoutSeconds", value); }
    private string HttpRetries { get => Get("retries", "0"); set => Put("retries", value); }
    private string HttpResultVariable { get => Get("resultVariable", "httpResult"); set => Put("resultVariable", value); }
    private string VarName { get => Get("name"); set => Put("name", value); }
    private string VarValue { get => Get("value"); set => Put("value", value); }
    private string EndOutput { get => Get("outputTemplate"); set => Put("outputTemplate", value); }
    private string SearchQuery { get => Get("query", "{input}"); set => Put("query", value); }
    private string SearchTopK { get => Get("topK", "3"); set => Put("topK", value); }
    private string SearchResultVariable { get => Get("resultVariable", "searchResult"); set => Put("resultVariable", value); }
    private string SubAgentTargetId { get => Get("targetAgentId"); set => Put("targetAgentId", value); }
    private string SubAgentInputTemplate { get => Get("inputTemplate", "{input}"); set => Put("inputTemplate", value); }
    private string SubAgentResultVariable { get => Get("resultVariable", "subAgentResult"); set => Put("resultVariable", value); }
    private string DbConnectionName { get => Get("connectionName"); set => Put("connectionName", value); }
    private string DbQuery { get => Get("query"); set => Put("query", value); }
    private string DbTimeout { get => Get("timeoutSeconds", "30"); set => Put("timeoutSeconds", value); }
    private string DbResultVariable { get => Get("resultVariable", "dbResult"); set => Put("resultVariable", value); }
    private string JsonParseInput { get => Get("input", "{input}"); set => Put("input", value); }
    private string JsonParsePath { get => Get("path"); set => Put("path", value); }
    private string JsonParseResultVariable { get => Get("resultVariable", "jsonResult"); set => Put("resultVariable", value); }
    private string ExpressionFormula { get => Get("formula"); set => Put("formula", value); }
    private string ExpressionResultVariable { get => Get("resultVariable", "result"); set => Put("resultVariable", value); }
    private string CollectionGetKey { get => Get("key"); set => Put("key", value); }
    private string CollectionGetDefault { get => Get("defaultValue"); set => Put("defaultValue", value); }
    private string CollectionGetResultVariable { get => Get("resultVariable", "collectionResult"); set => Put("resultVariable", value); }
    private string CollectionSetKey { get => Get("key"); set => Put("key", value); }
    private string CollectionSetValue { get => Get("value", "{input}"); set => Put("value", value); }

    private string DbParametersText
    {
        get => string.Join("\n", GetDict("parameters").Select(kv => $"{kv.Key}={kv.Value}"));
        set
        {
            var dict = new Dictionary<string, string>();
            foreach (var line in value.Split('\n'))
            {
                var trimmed = line.Trim();
                if (trimmed.Length == 0) continue;
                var idx = trimmed.IndexOf('=');
                if (idx > 0) dict[trimmed[..idx].Trim()] = trimmed[(idx + 1)..].Trim();
            }
            PutDict("parameters", dict);
        }
    }

    private string IntegratorName { get => Get("integratorName"); set => Put("integratorName", value); }
    private string IntegratorResultVariable { get => Get("resultVariable", "integratorResult"); set => Put("resultVariable", value); }

    private string IntegratorConfigText
    {
        get => string.Join("\n", GetDict("config").Select(kv => $"{kv.Key}={kv.Value}"));
        set
        {
            var dict = new Dictionary<string, string>();
            foreach (var line in value.Split('\n'))
            {
                var trimmed = line.Trim();
                if (trimmed.Length == 0) continue;
                var idx = trimmed.IndexOf('=');
                if (idx > 0) dict[trimmed[..idx].Trim()] = trimmed[(idx + 1)..].Trim();
            }
            PutDict("config", dict);
        }
    }

    private Dictionary<string, string> GetDict(string key)
    {
        if (Node is null || !Node.Props.TryGetValue(key, out var v) || v is null) return new();
        if (v is Dictionary<string, string> d) return d;
        if (v is System.Text.Json.JsonElement je && je.ValueKind == System.Text.Json.JsonValueKind.Object)
        {
            var result = new Dictionary<string, string>();
            foreach (var p in je.EnumerateObject())
                result[p.Name] = p.Value.ToString();
            return result;
        }
        return new();
    }

    private void PutDict(string key, Dictionary<string, string> value)
    {
        if (Node is not null) Node.Props[key] = value;
    }

    private void Changed()
    {
        if (Node is not null)
            NodeChanged.InvokeAsync(Node);
    }
}
