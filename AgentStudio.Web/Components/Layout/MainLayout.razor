@inherits LayoutComponentBase

<div class="studio-shell">
    <aside class="studio-rail">
        <div class="studio-brand" title="AgentStudio">AS</div>
        <nav>
            <NavLink href="/" Match="NavLinkMatch.All" title="Agents">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
                <span>Agents</span>
            </NavLink>
            <NavLink href="/providers" title="Model Providers">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M19.1 4.9L17 7M7 17l-2.1 2.1"/></svg>
                <span>Providers</span>
            </NavLink>
            <NavLink href="/analytics" title="Analytics">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 3v18h18"/><rect x="7" y="12" width="3" height="6"/><rect x="12" y="8" width="3" height="10"/><rect x="17" y="5" width="3" height="13"/></svg>
                <span>Analytics</span>
            </NavLink>
            <AuthorizeView Roles="Admin">
                <NavLink href="/users" title="Users">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    <span>Users</span>
                </NavLink>
                <NavLink href="/database-connections" title="Database Connections">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
                    <span>Databases</span>
                </NavLink>
            </AuthorizeView>
        </nav>
        <AuthorizeView>
            <Authorized>
                <div class="studio-account" title="@context.User.Identity?.Name">
                    <span>@context.User.Identity?.Name?[..1].ToUpperInvariant()</span>
                </div>
                <form method="post" action="/auth/logout" style="margin:0">
                    <button type="submit" class="studio-logout" title="Sign out">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                    </button>
                </form>
            </Authorized>
        </AuthorizeView>
    </aside>
    <main class="studio-main">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

<style>
    :root {
        --ink: #16161a;
        --ink-2: #57565e;
        --ink-3: #8b8a92;
        --paper: #ffffff;
        --mist: #f4f4f2;
        --hairline: #e5e4e0;
        --accent: #3b5bdb;
        --accent-soft: #edf0fd;
        --ok: #2f9e44;
        --err: #e03131;
        --mono: "JetBrains Mono", ui-monospace, "Cascadia Code", Consolas, monospace;
        --sans: "Inter", system-ui, -apple-system, sans-serif;
    }

    * { box-sizing: border-box; }
    body { margin: 0; }

    .studio-shell { display: flex; min-height: 100vh; font-family: var(--sans); color: var(--ink); background: var(--mist); }

    .studio-rail {
        width: 60px;
        background: var(--paper);
        border-right: 1px solid var(--hairline);
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: .75rem 0;
        flex-shrink: 0;
    }
    .studio-brand {
        font-family: var(--mono);
        font-weight: 700;
        font-size: .8rem;
        letter-spacing: .05em;
        color: var(--accent);
        border: 1.5px solid var(--accent);
        border-radius: 8px;
        width: 36px; height: 36px;
        display: flex; align-items: center; justify-content: center;
        margin-bottom: 1.25rem;
    }
    .studio-rail nav { display: flex; flex-direction: column; gap: .35rem; width: 100%; align-items: center; flex: 1; }
    .studio-account {
        width: 30px; height: 30px; border-radius: 50%;
        background: var(--accent-soft); color: var(--accent);
        display: flex; align-items: center; justify-content: center;
        font-weight: 700; font-size: .75rem; margin-bottom: .4rem;
    }
    .studio-logout {
        background: transparent; border: 0; color: var(--ink-3); cursor: pointer;
        padding: .4rem; border-radius: 6px; display: flex;
    }
    .studio-logout:hover { color: var(--err); background: var(--mist); }
    .studio-rail a {
        display: flex; flex-direction: column; align-items: center; gap: 3px;
        color: var(--ink-3); text-decoration: none;
        padding: .5rem 0; width: 48px; border-radius: 8px;
        font-size: .58rem; font-weight: 600; letter-spacing: .02em;
    }
    .studio-rail a:hover { color: var(--ink); background: var(--mist); }
    .studio-rail a.active { color: var(--accent); background: var(--accent-soft); }

    .studio-main { flex: 1; padding: 1.75rem 2.25rem; overflow: auto; }

    /* ---------- surfaces ---------- */
    .panel {
        background: var(--paper);
        border: 1px solid var(--hairline);
        border-radius: 10px;
        padding: 1.25rem 1.5rem;
        margin-bottom: 1.25rem;
    }
    .panel h2 { margin: 0 0 .35rem; font-size: 1.05rem; font-weight: 650; letter-spacing: -0.01em; }
    .panel h3 { font-size: .9rem; font-weight: 650; }
    .panel > p { color: var(--ink-2); font-size: .88rem; }

    /* ---------- forms ---------- */
    label {
        display: block;
        margin-top: .9rem;
        font-weight: 600;
        font-size: .72rem;
        color: var(--ink-2);
    }
    input[type=text], input[type=password], textarea, select {
        width: 100%;
        padding: .5rem .65rem;
        border: 1px solid var(--hairline);
        border-radius: 7px;
        font-size: .88rem;
        font-family: var(--sans);
        color: var(--ink);
        background: var(--paper);
        margin-top: .3rem;
        transition: border-color .12s;
    }
    input:focus, textarea:focus, select:focus {
        outline: none;
        border-color: var(--accent);
        box-shadow: 0 0 0 3px var(--accent-soft);
    }
    textarea { min-height: 84px; }

    /* ---------- buttons ---------- */
    button.primary, button.secondary {
        border: 0;
        border-radius: 7px;
        cursor: pointer;
        font-size: .85rem;
        font-weight: 600;
        font-family: var(--sans);
        padding: .5rem 1rem;
        margin-top: 1rem;
        transition: background .12s, color .12s;
    }
    button.primary { background: var(--ink); color: #fff; }
    button.primary:hover { background: #2a2a31; }
    button.secondary {
        background: transparent;
        color: var(--ink-2);
        border: 1px solid var(--hairline);
        margin-left: .5rem;
    }
    button.secondary:hover { border-color: var(--ink-3); color: var(--ink); }
    button:disabled { opacity: .45; cursor: default; }

    /* ---------- table ---------- */
    table { width: 100%; border-collapse: collapse; margin-top: .5rem; }
    th {
        text-align: left;
        font-size: .68rem;
        font-weight: 700;
        color: var(--ink-3);
        letter-spacing: .04em;
        padding: .4rem .75rem .6rem;
        border-bottom: 1px solid var(--hairline);
    }
    td {
        padding: .55rem .75rem;
        border-bottom: 1px solid var(--hairline);
        font-size: .87rem;
    }
    tr:last-child td { border-bottom: 0; }
    td a { color: var(--accent); text-decoration: none; font-weight: 600; }
    code {
        font-family: var(--mono);
        font-size: .8em;
        background: var(--mist);
        padding: .1rem .4rem;
        border-radius: 5px;
    }

    /* ---------- badges ---------- */
    .badge {
        display: inline-block;
        padding: .12rem .55rem;
        border-radius: 999px;
        font-size: .7rem;
        font-weight: 600;
        background: var(--mist);
        color: var(--ink-2);
        border: 1px solid var(--hairline);
        margin-right: .25rem;
    }
    .badge.published { background: #ebfbee; color: var(--ok); border-color: #d3f0da; }
    .error-list { color: var(--err); font-size: .85rem; }

    /* ---------- test chat ---------- */
    .chat-box {
        border: 1px solid var(--hairline);
        border-radius: 10px;
        padding: 1rem;
        height: 320px;
        overflow-y: auto;
        background: var(--mist);
    }
    .chat-msg { margin-bottom: .8rem; }
    .chat-msg .role {
        font-family: var(--mono);
        font-size: .65rem;
        color: var(--ink-3);
        margin-bottom: .15rem;
    }
    .chat-msg .content {
        white-space: pre-wrap;
        font-size: .88rem;
        background: var(--paper);
        border: 1px solid var(--hairline);
        border-radius: 8px;
        padding: .5rem .75rem;
        display: inline-block;
        max-width: 85%;
    }
    .chat-msg.user { text-align: right; }
    .chat-msg.user .content { background: var(--accent-soft); border-color: #d7defb; text-align: left; }
    .chat-result-table-wrap { overflow-x: auto; }
    .chat-result-table { width: 100%; border-collapse: collapse; font-size: .85rem; white-space: normal; }
    .chat-result-table th, .chat-result-table td {
        text-align: left;
        padding: .35rem .5rem;
        border-bottom: 1px solid var(--hairline);
        white-space: nowrap;
    }
    .chat-result-table th { font-weight: 650; }
</style>
