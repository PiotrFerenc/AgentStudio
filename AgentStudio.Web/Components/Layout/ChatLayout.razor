@inherits LayoutComponentBase

<div class="public-chat-shell">
    @Body
</div>

<style>
    body { margin: 0; }
    .public-chat-shell {
        min-height: 100vh;
        background: #f4f4f2;
        font-family: "Inter", system-ui, -apple-system, sans-serif;
        color: #16161a;
        display: flex;
        flex-direction: column;
    }
    .chat-page {
        display: flex;
        flex-direction: column;
        height: 100vh;
        max-width: 720px;
        width: 100%;
        margin: 0 auto;
        background: #fff;
        border-left: 1px solid #e5e4e0;
        border-right: 1px solid #e5e4e0;
    }
    .chat-header {
        padding: .85rem 1.25rem;
        border-bottom: 1px solid #e5e4e0;
        display: flex;
        align-items: baseline;
        gap: .75rem;
    }
    .chat-header strong { font-size: .95rem; font-weight: 650; }
    .chat-header-sub {
        font-family: "JetBrains Mono", ui-monospace, monospace;
        font-size: .68rem;
        color: #8b8a92;
    }
    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: .55rem;
    }
    .chat-empty { color: #8b8a92; text-align: center; margin-top: 3rem; font-size: .9rem; }
    .chat-bubble-row { display: flex; }
    .chat-bubble-row.user { justify-content: flex-end; }
    .chat-bubble {
        max-width: 75%;
        padding: .55rem .85rem;
        border-radius: 12px;
        white-space: pre-wrap;
        font-size: .9rem;
        line-height: 1.45;
    }
    .chat-bubble.user {
        background: #16161a;
        color: #fff;
        border-bottom-right-radius: 4px;
    }
    .chat-bubble.assistant {
        background: #f4f4f2;
        color: #16161a;
        border: 1px solid #e5e4e0;
        border-bottom-left-radius: 4px;
    }
    .chat-input-row {
        display: flex;
        gap: .5rem;
        padding: .85rem 1.25rem;
        border-top: 1px solid #e5e4e0;
    }
    .chat-input-row input {
        flex: 1;
        padding: .6rem .8rem;
        border: 1px solid #e5e4e0;
        border-radius: 8px;
        font-size: .9rem;
        font-family: inherit;
    }
    .chat-input-row input:focus {
        outline: none;
        border-color: #3b5bdb;
        box-shadow: 0 0 0 3px #edf0fd;
    }
    .chat-input-row button {
        background: #16161a;
        color: #fff;
        border: 0;
        border-radius: 8px;
        padding: .6rem 1.15rem;
        cursor: pointer;
        font-size: .88rem;
        font-weight: 600;
        font-family: inherit;
    }
    .chat-input-row button:hover { background: #2a2a31; }
    .chat-input-row button:disabled { opacity: .4; cursor: default; }
    .chat-key-gate {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
    }
    .chat-key-box {
        background: #fff;
        border: 1px solid #e5e4e0;
        border-radius: 12px;
        padding: 2.25rem 2.5rem;
        text-align: center;
        max-width: 380px;
        width: 100%;
    }
    .chat-key-box h2 { margin: 0 0 .4rem; font-size: 1.1rem; font-weight: 650; }
    .chat-key-box p { color: #57565e; font-size: .88rem; }
    .chat-key-box input {
        width: 100%;
        padding: .6rem .8rem;
        border: 1px solid #e5e4e0;
        border-radius: 8px;
        margin: .75rem 0;
        box-sizing: border-box;
        font-family: "JetBrains Mono", ui-monospace, monospace;
        font-size: .85rem;
    }
    .chat-key-box input:focus { outline: none; border-color: #3b5bdb; box-shadow: 0 0 0 3px #edf0fd; }
    .chat-key-box button {
        background: #16161a;
        color: #fff;
        border: 0;
        border-radius: 8px;
        padding: .6rem 1.4rem;
        cursor: pointer;
        width: 100%;
        font-weight: 600;
        font-family: inherit;
    }
    .chat-key-error { color: #e03131; font-size: .82rem; }
    .chat-error {
        max-width: 440px;
        margin: 4rem auto;
        background: #fff;
        border: 1px solid #e5e4e0;
        border-radius: 12px;
        padding: 2rem;
        text-align: center;
    }
</style>
